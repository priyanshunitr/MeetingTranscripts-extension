# Firebase
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
FIRESTORE_DATABASE_ID=meetai

# Auth
# Frontend should authenticate with Firebase Google OAuth and send:
# Authorization: Bearer <firebase_id_token>

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Grok / xAI
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4.3

# OpenAI Embeddings
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=recording_chunks
QDRANT_VECTOR_SIZE=1536
# QDRANT_API_KEY=optional_qdrant_api_key

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name
# AWS_SESSION_TOKEN=optional_session_token

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=optional_redis_password
# REDIS_URL=redis://127.0.0.1:6379

# Workers
START_RECORDING_WORKER=true
RECORDING_WORKER_CONCURRENCY=1
